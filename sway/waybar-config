{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "backlight", "sway/language", "battery"],

    "sway/language": {
        "format": "  {}",
        "min-length": 5
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "Ȁ {ifname}",
        "format-disconnected": "֪ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "foot --app-id nmtui_float -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "ݟ Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
